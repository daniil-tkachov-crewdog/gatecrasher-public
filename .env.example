# =========================
# Node / Environment
# =========================
NODE_ENV=development
APP_BASE_URL=http://localhost:3000            # prod = https://crewdog.app
APP_ORIGIN=http://localhost:3000              # prod = https://crewdog.app
TRUST_PROXY=1                                 # Required for Render or any reverse proxy

# =========================
# Stripe Configuration
# =========================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Primary product/price IDs
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_2GBP=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # or your GBP plan price_id

# Billing portal config (from Stripe Dashboard → Billing → Customer Portal)
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (optional) test-only extra keys
STRIPE_TEST_CUSTOMER_ID=cus_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================
# Webhooks / External
# =========================
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/gatecrasher
N8N_ENDPOINT_URL=https://your-n8n-instance

# =========================
# Supabase Configuration
# =========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# =========================
# Admin / API Keys
# =========================
ADMIN_API_KEY=super-secret-admin-key
ADMIN_CANCEL_KEY=super-secret-admin-key

# =========================
# Rate Limiting + Security
# =========================
# Rate-limit window (default 15 min)
RATE_LIMIT_WINDOW_MS=900000

# Requests per window
RATE_LIMIT_MAX=5000
RATE_LIMIT_LOOSE_MAX=20000

# Skip successful requests (handy in dev/test)
RATE_LIMIT_SKIP_SUCCESS=1

# Optional: bypass token (for testing — send header `x-rl-bypass: xyz`)
RL_BYPASS_TOKEN=xyz123

# Disable limiter entirely (not recommended)
RATE_LIMIT_DISABLE=0

# =========================
# Logging / Analytics
# =========================
LOG_LEVEL=info
ENABLE_DEBUG=1
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =========================
# Misc
# =========================
PORT=3000
